<Window x:Class="MediaSorter.MainWindow"
        x:ClassModifier="public"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media Sorter"
        Width="1040" Height="760"
        MinWidth="760" MinHeight="540"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI"
        FontSize="14"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================ header ================================ -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,13">
            <DockPanel LastChildFill="False">

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="0" Background="{StaticResource AccentBrush}">
                        <Path Data="M2,19 L2,6 L9,6 L11,4 L22,4 L22,19 Z"
                              Fill="#000000"
                              Stretch="Uniform"
                              Width="19" Height="19"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Media Sorter"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="{Binding StepLabel}"
                                   FontSize="12"
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="Mode"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,9,0" />
                    <ToggleButton Content="{Binding ModeLabel}"
                                  IsChecked="{Binding MoveFiles}"
                                  Style="{StaticResource ChipToggle}"
                                  ToolTip="Switch between moving the files and copying them" />
                    <CheckBox Content="Include subfolders"
                              IsChecked="{Binding IncludeSubfolders}"
                              Style="{StaticResource ChipCheck}"
                              Margin="16,0,0,0"
                              VerticalAlignment="Center"
                              ToolTip="Include files in subfolders too" />
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- =============================== transcript ============================= -->
        <ListBox x:Name="ChatList"
                 Grid.Row="1"
                 ItemsSource="{Binding Messages}"
                 Background="Transparent"
                 BorderThickness="0"
                 BorderBrush="Transparent"
                 Padding="0,8"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="False"
                 VirtualizingStackPanel.IsVirtualizing="False"
                 Focusable="False">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- ================================ progress ============================= -->
        <Border Grid.Row="2"
                Margin="18,0,18,10"
                Padding="14,10"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="0"
                Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding ProgressText}"
                               FontSize="12"
                               Margin="14,0,0,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding StatusText}"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}" />
                </DockPanel>

                <Grid Height="6" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding ProgressGridWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource AccentBrush}" CornerRadius="0" />
                    <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="0" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ================================= input =============================== -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,13,18,15">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{StaticResource InputBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="0"
                            Padding="1,0">
                        <TextBox x:Name="InputBox"
                                 Style="{StaticResource InputStyle}"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnInputKeyDown" />
                    </Border>

                    <Button Grid.Column="1"
                            Content="Browse…"
                            Command="{Binding BrowseCommand}"
                            Style="{StaticResource GhostButton}"
                            Margin="10,0,0,0" />

                    <Button Grid.Column="2"
                            Content="Send"
                            Command="{Binding SendCommand}"
                            Style="{StaticResource SendButton}"
                            Margin="10,0,0,0" />

                    <!-- Always present; lights up whenever a run is in progress. -->
                    <Button Grid.Column="3"
                            Content="Cancel run"
                            Command="{Binding CancelCommand}"
                            IsEnabled="{Binding CancelEnabled}"
                            Style="{StaticResource GhostButton}"
                            Margin="10,0,0,0"
                            ToolTip="Stop the current run (same as /cancel)" />
                </Grid>

                <TextBlock Margin="2,8,0,0"
                           FontSize="11.5"
                           Foreground="{StaticResource MutedBrush}"
                           Text="Enter sends  ·  type /help for commands  ·  drop a folder anywhere in this window" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
