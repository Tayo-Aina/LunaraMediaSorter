<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <AssemblyName>MediaSorterApp</AssemblyName>
    <RootNamespace>MediaSorter</RootNamespace>
    <Product>Media Sorter</Product>
    <AssemblyTitle>Media Sorter</AssemblyTitle>
    <ApplicationIcon>MediaSorterApp.ico</ApplicationIcon>
    <Version>1.0.0-beta.1</Version>
    <Description>Chat-driven desktop organizer that files video downloads into show / season folders.</Description>

    <!-- Keep the published output small: only English satellite resources. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Anitomy: filename parsing (zero dependencies). -->
    <PackageReference Include="AnitomySharp.NET6" Version="0.5.1" />
    <!-- FuzzySharp: token-set fuzzy matching (zero dependencies). -->
    <PackageReference Include="FuzzySharp" Version="2.0.2" />
    <!-- ONNX Runtime: runs the local MiniLM embedding model used to match files to the show name. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The embedding model + vocab must ship next to the executable. -->
    <None Update="Models\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
