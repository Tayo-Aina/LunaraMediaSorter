<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>EngineTests</AssemblyName>
    <RootNamespace>EngineTests</RootNamespace>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile the real engine sources so the tests exercise the shipping code. -->
    <Compile Include="..\MediaSorterApp\Engine\*.cs" LinkBase="Engine" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AnitomySharp.NET6" Version="0.5.1" />
    <PackageReference Include="FuzzySharp" Version="2.0.2" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
  </ItemGroup>

</Project>
